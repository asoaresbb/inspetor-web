@using selenium_web.Adapters.Interfaces
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Inspetor Web</h1>
    <p>Enter a URL and select an action to perform with Selenium.</p>
</div>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <form method="post" action="@Url.Action("ProcessAction", "Home")">
            <div class="form-group mb-3">
                <input type="url" class="form-control" id="urlInput" name="url"
                       placeholder="Enter URL (e.g., https://example.com)"
                       value="@ViewData["url"]" pattern="https?://.+" required>
            </div>

            <div id="actionButtons" class="form-group mb-3 d-flex justify-content-center">
                <button class="btn btn-primary mx-2" type="submit" id="btnAction1" name="actionButton"
                        value="screenshot">Take Screenshot
                </button>
                <button class="btn btn-primary mx-2" type="submit" name="actionButton" value="readingmode">Reading
                    Mode
                </button>
                <button class="btn btn-primary mx-2" type="submit" name="actionButton" value="headingsStructure">
                    Headings Structure
                </button>
                <button class="btn btn-primary mx-2" type="submit" name="actionButton" value="links">External Links
                </button>
            </div>

            <div id="loadingMessage" class="alert alert-secondary text-center d-none" role="status">
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                <span id="loadingText"></span>
                <div class="small text-muted mt-1">This can take a few seconds.</div>
            </div>

            @if (ViewData["Erro"] != null)
            {
                <div id="errorMessage" class="alert alert-danger">
                    @ViewData["Erro"]
                </div>
            }
        </form>
    </div>
</div>

<div id="results">
@if (ViewData["ImagemBase64"] != null)
{
    <div class="mt-4">
        <div class="card" id="screenshotTaken">
            <div class="card-header">
                <h3>Screenshot Result</h3>
            </div>
            <div class="card-body text-center">
                <img src="data:image/png;base64,@ViewData["ImagemBase64"]" class="img-fluid" alt="Screenshot"/>
            </div>
        </div>
    </div>
}

@if (ViewData["ReadData"] is List<ReadingBlock> readingBlocks)
{
    <div class="mt-4">
        <div class="card" id="readingModeResult">
            <div class="card-header">
                <h3>Reading Mode Result</h3>
            </div>
            <div class="card-body">
                @* Plain text only: Razor encodes it, so nothing from the inspected page runs here *@
                <div class="reading-mode">
                    @foreach (var block in readingBlocks)
                    {
                        switch (block.Tag)
                        {
                            case "h1" or "h2" or "h3" or "h4" or "h5" or "h6":
                                <p class="reading-heading reading-@block.Tag" role="heading"
                                   aria-level="@block.Tag[1..]">@block.Text</p>
                                break;
                            case "li":
                                <p class="reading-list-item">@block.Text</p>
                                break;
                            case "blockquote":
                                <blockquote>@block.Text</blockquote>
                                break;
                            case "pre":
                                <pre>@block.Text</pre>
                                break;
                            case "hr":
                                <hr class="reading-separator"/>
                                break;
                            default:
                                <p>@block.Text</p>
                                break;
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (ViewData["Headings"] is List<Heading> { Count: 0 })
{
    <div id="noResults" class="alert alert-info mt-4">No headings found on this page.</div>
}
else if (ViewData["Headings"] is List<Heading> headings)
{
    @* Each level is indented further, so the hierarchy of the page is visible *@
    <ul id="headingsResult" class="headings-structure">
        @foreach (var heading in headings)
        {
            <li class="heading-level-@heading.Level" data-level="@heading.Level">
                <span class="heading-tag">H@(heading.Level)</span>
                @heading.Text
                @if (heading.Visibility == HeadingVisibility.Hidden)
                {
                    <span class="heading-flag">(hidden)</span>
                }
                else if (heading.Visibility == HeadingVisibility.Empty)
                {
                    <span class="heading-flag heading-flag-empty">(empty)</span>
                }
            </li>
        }
    </ul>
}

@if (ViewData["Links"] is List<Link> { Count: 0 })
{
    <div id="noResults" class="alert alert-info mt-4">No external links found on this page.</div>
}
else if (ViewData["Links"] is List<Link> links)
{
    <ul id="externalLinks">
        @foreach (var link in links)
        {
            <li>
                <a target="_blank" href="@link.Url">@link.Text</a>
            </li>
        }
    </ul>
}

</div>

<script>
    document.getElementById('urlInput').addEventListener('blur', (event) => {
        // Add https:// only to a typed address without a scheme (e.g. "cnn.com").
        // An empty field stays empty, otherwise typing afterwards gives "https://http://..."
        const value = (event.target.value ?? '').trim();
        if (value !== '' && !/^[a-z]+:\/\//i.test(value))
            event.target.value = 'https://' + value;
    })

    const loadingTexts = {
        screenshot: 'Taking screenshot...',
        readingmode: 'Extracting the main content...',
        headingsStructure: 'Reading the headings...',
        links: 'Finding external links...'
    };

    document.getElementsByTagName('form')[0].addEventListener('submit', (event) => {
        document.getElementById('loadingText').textContent = loadingTexts[event.submitter?.value] ?? 'Loading...';
        // The timeout lets the browser submit the clicked button's value before the buttons are hidden
        setTimeout(() => {
            document.getElementById('actionButtons').classList.add('d-none');
            document.getElementById('errorMessage')?.remove();
            document.getElementById('results').classList.add('d-none');
            document.getElementById('loadingMessage').classList.remove('d-none');
        }, 0);
    })
</script>
